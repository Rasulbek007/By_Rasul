function openDetail(ru) {
  const word = getAllWords().find(w => w.ru === ru) || customWords.find(w => w.ru === ru);
  if (!word) return;
  currentWord = word;
  document.getElementById("home-view").style.display = "none";
  const dv = document.getElementById("detail-view");
  dv.style.display = "flex";
  dv.classList.add("fade-in");
  document.getElementById("detail-title").textContent = word.ru;
  
  const isCustom = customWords.includes(word);
  let tagsHtml = "";
  if (word.type === "НСВ") tagsHtml += `<span class="word-tag tag-НСВ">НСВ</span> `;
  if (word.type === "СВ") tagsHtml += `<span class="word-tag tag-СВ">СВ</span> `;
  if (word.transport === "ж") tagsHtml += `<span class="word-tag tag-ж">🚶 жаяу</span> `;
  if (word.transport === "к") tagsHtml += `<span class="word-tag tag-к">🚗 көлік</span> `;
  
  let examplesHtml = "";
  if (word.examples && word.examples.length) {
    examplesHtml = `<div class="examples-card"><div class="ex-title">💬 Мысалдар</div>`;
    word.examples.forEach(ex => {
      examplesHtml += `<div class="ex-row"><span class="ex-ru">${ex.ru}</span><button class="conj-sound" onclick="speak('${ex.ru}')">🔊</button><div class="ex-kz">${ex.kz}</div></div>`;
    });
    examplesHtml += `</div>`;
  }
  
  const renderTense = (title, dotClass, forms, trans) => {
    if (forms[0] === "—") return "";
    return `<div class="tense-section">
      <div class="tense-title"><div class="dot ${dotClass}"></div> ${title}</div>
      <div class="conjugation-card">
        ${forms.map((form, i) => `
          <div class="conj-row">
            <div class="conj-pronoun">${pronouns[i]}</div>
            <div style="flex:1">
              <div class="conj-form">${form}</div>
              <div class="conj-translation">${trans[i]}</div>
            </div>
            <button class="conj-sound" onclick="speak('${form.replace(/[\/]/g, '').split(' ')[0]}')">🔊</button>
          </div>
        `).join("")}
      </div>
    </div>`;
  };
  
  const imperativeHtml = word.imperative && word.imperative[0] !== "—" ? `
    <div class="tense-section">
      <div class="tense-title"><div class="dot dot-imperative"></div> 💬 БҰЙРЫҚ РАЙ</div>
      <div class="conjugation-card">
        <div class="conj-row"><div class="conj-pronoun">ты</div><div class="conj-form">${word.imperative[0]}</div></div>
        <div class="conj-row"><div class="conj-pronoun">вы</div><div class="conj-form">${word.imperative[1]}</div></div>
      </div>
    </div>` : "";
  
  document.getElementById("detail-content").innerHTML = `
    <div class="hero">
      <div class="hero-word">${word.icon || "📝"} ${word.ru}</div>
      ${word.pron ? `<div class="hero-pron">[${word.pron}]</div>` : ""}
      <div class="hero-kz">${word.kz}</div>
      <div class="hero-tags">${tagsHtml}</div>
      <div class="hero-actions">
        <button class="hero-btn" onclick="speak('${word.ru}')">🔊 Айтылуы</button>
        ${isCustom ? `<button class="hero-btn" onclick="deleteCustomWord('${word.ru}')">🗑 Жою</button>` : ""}
      </div>
    </div>
    ${examplesHtml}
    ${renderTense("🟢 ОСЫ ШАҚ (что делает?)", "dot-present", word.present, word.translations)}
    ${renderTense("🟡 ӨТКЕН ШАҚ (что делал?)", "dot-past", word.past, word.past_translations || word.translations)}
    ${renderTense("🔵 КЕЛЕР ШАҚ (что будет делать?)", "dot-future", word.future, word.translations)}
    ${imperativeHtml}
    <div style="height:40px"></div>
  `;
}

