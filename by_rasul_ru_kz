<body>
<div id="app">
  <div id="home-view">
    <div class="header">
      <div style="width:32px"></div>
      <h1>🇷🇺 СӨЗДЕР</h1>
      <button class="icon-btn" id="info-btn">ℹ️</button>
    </div>
    
    <div class="search-row">
      <input type="text" class="search-input" id="search" placeholder="Сөз іздеу..."/>
    </div>
    
    <div class="filter-row">
      <div class="filter-tab active" data-cat="all">Барлығы</div>
      <div class="filter-tab" data-cat="Негізгі">📚 Негізгі</div>
      <div class="filter-tab" data-cat="Қозғалыс">🚶 Қозғалыс</div>
      <div class="filter-tab" data-cat="Салыстыру">⚖️</div>
      <div class="filter-tab" data-cat="Жиілік">⏰</div>
      <div class="filter-tab" data-cat="Менің">⭐</div>
    </div>
    
    <div class="list" id="word-list"></div>
    
    <button class="add-btn" id="add-btn">+</button>
    <button class="practice-btn" id="practice-btn">📝</button>
  </div>
  
  <div id="detail-view">
    <div class="detail-header">
      <button class="back" id="detail-back">‹</button>
      <div class="title" id="detail-title">Сөз</div>
      <div style="width:32px"></div>
    </div>
    <div id="detail-content"></div>
  </div>
  
  <div id="practice-view">
    <div class="detail-header">
      <button class="back" id="practice-back">‹</button>
      <div class="title">📝 Жаттығулар</div>
      <div style="width:32px"></div>
    </div>
    <div id="practice-content"></div>
  </div>
</div>

<div class="install-prompt" id="install-prompt">
  <div class="ip-text">
    <div class="ip-title">📱 Приложениеге қосу</div>
    <div>Safari → 📤 → "Үй экранына қосу"</div>
  </div>
  <button class="ip-btn" id="install-btn">ОК</button>
  <button class="ip-close" id="install-close">✕</button>
</div>

<div class="modal-back" id="add-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">➕ Жаңа сөз</div>
      <button class="modal-close" data-close>✕</button>
    </div>
    <div class="modal-body">
      <div class="form-row">
        <label class="form-label">Орысша</label>
        <input type="text" class="form-input" id="new-ru" placeholder="мысалы: гулять"/>
      </div>
      <div class="form-row">
        <label class="form-label">Қазақша</label>
        <input type="text" class="form-input" id="new-kz" placeholder="мысалы: серуендеу"/>
      </div>
      <div class="form-row">
        <label class="form-label">Айтылуы</label>
        <input type="text" class="form-input" id="new-pron" placeholder="gulyat'"/>
      </div>
      <div class="form-row">
        <label class="form-label">Категория</label>
        <select class="form-select" id="new-cat">
          <option>Негізгі</option>
          <option>Қозғалыс</option>
          <option>Әрекет</option>
          <option>Сөйлеу</option>
          <option>Тамақ</option>
          <option>Оқу</option>
          <option>Жұмыс</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-close">Болдырмау</button>
      <button class="btn btn-primary" id="save-word">💾 Сақтау</button>
    </div>
  </div>
</div>

<div class="modal-back" id="info-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">ℹ️ Анықтама</div>
      <button class="modal-close" data-close>✕</button>
    </div>
    <div class="modal-body" style="font-size:13px; line-height:1.6">
      <p style="margin-bottom:8px"><b>🚶 Қозғалыс:</b> 21 етістік</p>
      <p style="margin-bottom:8px"><b>⏰ НСВ/СВ:</b> НСВ = үнемі, СВ = бір рет</p>
      <p style="margin-bottom:8px"><b>📝 Жаттығу:</b> 10 тест</p>
      <p style="margin-bottom:8px"><b>⚖️ Салыстыру:</b> 5 кесте</p>
      <p style="margin-bottom:8px"><b>⏰ Жиілік:</b> 16 сөз</p>
      <p><b>➕ + батырма:</b> Өз сөзіңіз</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" data-close">Жабу</button>
    </div>
  </div>
</div>

<script>
const STORE_KEY = "russian_words_pwa";
let customWords = JSON.parse(localStorage.getItem(STORE_KEY) || "[]");

// =============== НЕГІЗГІ СӨЗДЕР (18) ===============
const baseWords = [
  {ru:"спать", kz:"ұйықтау", pron:"spat'", cat:"Негізгі", icon:"😴", type:"НСВ",
   present:["я сплю","ты спишь","он спит","мы спим","вы спите","они спят"],
   past:["я спал/спала","ты спал/спала","он спал","мы спали","вы спали","они спали"],
   future:["я буду спать","ты будешь спать","он будет спать","мы будем спать","вы будете спать","они будут спать"],
   imperative:["спи","спите"],
   translations:["Мен ұйықтап жатырмын","Сен ұйықтап жатырсың","Ол ұйықтап жатыр","Біз ұйықтап жатырмыз","Сіздер ұйықтап жатырсыздар","Олар ұйықтап жатыр"],
   past_translations:["Мен ұйықтадым","Сен ұйықтадың","Ол ұйықтады","Біз ұйықтадық","Сіздер ұйықтадыңыздар","Олар ұйықтады"],
   examples:[{ru:"Я сплю 8 часов.", kz:"Мен 8 сағат ұйықтаймын.", pron:"ya splyu 8 chasov"}]},
  {ru:"есть", kz:"жеу", pron:"yest'", cat:"Негізгі", icon:"🍽️", type:"НСВ",
   present:["я ем","ты ешь","он ест","мы едим","вы едите","они едят"],
   past:["я ел/ела","ты ел/ела","он ел","мы ели","вы ели","они ели"],
