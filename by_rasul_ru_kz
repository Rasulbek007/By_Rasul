function showQuiz() {
  if (quizState.idx >= quizzes.length) {
    const pct = Math.round(quizState.score / quizzes.length * 100);
    let msg = pct >= 80 ? "🏆 Тамаша!" : pct >= 50 ? "👍 Жақсы!" : "📚 Қайтала";
    document.getElementById("practice-content").innerHTML = `
      <div style="text-align:center; padding:40px 20px">
        <div style="font-size:60px; margin-bottom:20px">${pct >= 80 ? "🏆" : "📝"}</div>
        <div style="font-size:24px; font-weight:700; color:#4ade80; margin-bottom:10px">${quizState.score} / ${quizzes.length}</div>
        <div style="color:#888; margin-bottom:20px">${pct}% дұрыс</div>
        <div style="font-size:18px; margin-bottom:24px">${msg}</div>
        <button class="btn btn-primary" onclick="quizState={idx:0,score:0,answered:false}; showQuiz()" style="font-size:14px; padding:12px 24px">🔄 Қайта бастау</button>
      </div>
    `;
    return;
  }
  const q = quizzes[quizState.idx];
  document.getElementById("practice-content").innerHTML = `
    <div class="quiz-progress">Сұрақ ${quizState.idx + 1} / ${quizzes.length} · ⭐ ${quizState.score}</div>
    <div class="quiz-card">
      <div class="quiz-q">${q.q.replace("________", '<span class="blank">?</span>')}</div>
      <div class="quiz-options">
        ${q.options.map(o => `<button class="quiz-opt" data-opt="${o}">${o}</button>`).join("")}
      </div>
      <div id="quiz-explain"></div>
    </div>
  `;
  document.querySelectorAll(".quiz-opt").forEach(btn => {
    btn.onclick = () => {
      if (quizState.answered) return;
      quizState.answered = true;
      const chosen = btn.dataset.opt;
      const isCorrect = chosen === q.answer;
      if (isCorrect) {
        quizState.score++;
        btn.classList.add("correct");
        document.getElementById("quiz-explain").innerHTML = `<div class="quiz-explain">✅ <b>Дұрыс!</b><br>${q.explain}</div>`;
      } else {
        btn.classList.add("wrong");
        document.querySelector(`.quiz-opt[data-opt="${q.answer}"]`).classList.add("correct");
        document.getElementById("quiz-explain").innerHTML = `<div class="quiz-explain" style="background:#3a1e1e;border-color:#dc2626;color:#fcd4aa">❌ <b>Қате!</b> Дұрысы: <b>${q.answer}</b><br>${q.explain}</div>`;
      }
      document.querySelectorAll(".quiz-opt").forEach(b => b.disabled = true);
      setTimeout(() => { quizState.idx++; quizState.answered = false; showQuiz(); }, 2200);
    };
  });
}

// PWA install prompt
function showInstallPrompt() {
  const isStandalone = window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
  if (isStandalone) return;
  const dismissed = localStorage.getItem('install_dismissed');
  if (dismissed && Date.now() - parseInt(dismissed) < 7 * 24 * 60 * 60 * 1000) return;
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  const isAndroid = /Android/.test(navigator.userAgent);
  if (isIOS || isAndroid) {
    setTimeout(() => document.getElementById('install-prompt').classList.add('show'), 3000);
  }
}

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  setTimeout(() => document.getElementById('install-prompt').classList.add('show'), 3000);
});

renderList();
showInstallPrompt();
</script>
